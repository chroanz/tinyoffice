# Copie para .env e ajuste. Todos os valores têm defaults sensatos em dev.

# Backend
PIXELROOMS_ADDR=:8080
PIXELROOMS_ENV=development
PIXELROOMS_DATABASE_URL=postgres://pixelrooms:pixelrooms@localhost:5432/pixelrooms?sslmode=disable
PIXELROOMS_REDIS_URL=redis://localhost:6379/0
PIXELROOMS_JWT_SECRET=troque-este-segredo-em-producao

# LiveKit (Fase 2)
PIXELROOMS_LIVEKIT_URL=ws://localhost:7880
PIXELROOMS_LIVEKIT_API_KEY=
PIXELROOMS_LIVEKIT_API_SECRET=
